load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//go:def.bzl", "go_test")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "protovcs",
    srcs = [
        "canonical.go",
        "chunkcache.go",
        "digest.go",
        "headmarks.go",
        "layout.go",
        "manifest.go",
        "materialize.go",
        "memo.go",
        "partial.go",
        "probe.go",
        "rewrite.go",
        "seal.go",
        "store.go",
        "transport.go",
        "types.go",
        "version.go",
    ],
    importpath = "github.com/nextgui/protovcs",
    deps = [
        "//proto/protovcs/v1",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@org_golang_google_protobuf//types/descriptorpb",
        "@org_golang_google_protobuf//types/dynamicpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "protovcs_test",
    size = "small",
    srcs = [
        "canonical_test.go",
        "chunkcache_test.go",
        "complexity_test.go",
        "packhint_test.go",
        "crash_test.go",
        "export_test.go",
        "fuzz_test.go",
        "generated_test.go",
        "headmarks_test.go",
        "identity_test.go",
        "incremental_test.go",
        "itemsize_test.go",
        "layout_test.go",
        "log_test.go",
        "readat_test.go",
        "rewrite_test.go",
        "manifest_order_test.go",
        "manifest_test.go",
        "materialize_test.go",
        "memo_test.go",
        "nested_test.go",
        "partial_test.go",
        "seal_test.go",
        "soak_test.go",
        "store_test.go",
        "version_test.go",
        "watch_test.go",
    ],
    embed = [":protovcs"],
    deps = [
        "//memtransport",
        "//proto/protovcs/testpb",
        "//proto/protovcs/testpb:teststorelayout",
        "//proto/protovcs/v1",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)


exports_files([
    "go.mod",
    # The Rust client's tests in rust/ reproduce it.
    "testdata/golden/vectors.json",
])

# Golden vectors for the Rust client in rust/, which its tests must reproduce
# byte for byte. This test writes them, and update_golden's test fails when the
# checked-in copy is stale. Update with bazel run //:update_golden.
go_test(
    name = "golden_vectors_gen",
    size = "small",
    srcs = [
        "golden_export_test.go",
        "golden_test.go",
    ],
    embed = [":protovcs"],
    deps = [
        "//memtransport",
        "//proto/protovcs/testpb",
        "//proto/protovcs/v1",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/descriptorpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

genrule(
    name = "golden_vectors",
    testonly = True,
    outs = ["golden_vectors.json"],
    cmd = "$(execpath :golden_vectors_gen) -test.run=TestGoldenVectors -golden_out=$@ > /dev/null",
    tools = [":golden_vectors_gen"],
)

write_source_files(
    name = "update_golden",
    testonly = True,
    files = {"testdata/golden/vectors.json": ":golden_vectors"},
)
