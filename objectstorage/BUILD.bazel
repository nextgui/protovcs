load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//go:def.bzl", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "objectstorage",
    srcs = [
        "bucket.go",
        "dirbucket.go",
        "dirlock.go",
        "dirupload.go",
        "pack.go",
        "storage.go",
    ],
    importpath = "github.com/nextgui/protovcs/objectstorage",
    deps = [
        "//server",
        "//:protovcs",
        "//proto/protovcs/v1",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "objectstorage_test",
    # Medium for TestPackedColdRead, which writes and reads ten years of daily
    # items through a bucket that sleeps on every request.
    size = "medium",
    srcs = [
        "conformance_test.go",
        "dirlock_test.go",
        "pack_internal_test.go",
        "pack_test.go",
        "refcas_test.go",
        "storage_test.go",
    ],
    embed = [":objectstorage"],
    deps = [
        "//internal/gcsemulator",
        "//objectstorage/gcsbucket",
        "//server",
        "//:protovcs",
        "//proto/protovcs/testpb",
        "//proto/protovcs/testpb:teststorelayout",
        "//proto/protovcs/v1",
        "@com_google_cloud_go_storage//:storage",
        "@org_golang_google_api//option",
        "@org_golang_google_protobuf//proto",
    ],
)
